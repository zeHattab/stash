default_platform(:ios)

platform :ios do
  # Загрузка текстов и скриншотов версии 1.0 в App Store Connect БЕЗ отправки на проверку.
  # Бинарь не трогаем (его льёт testflight.yml). Требует секретов ASC_* в окружении.
  desc "Upload App Store metadata and screenshots (no binary, no submission)"
  lane :upload_metadata do
    api_key = app_store_connect_api_key(
      key_id: ENV["ASC_KEY_ID"],
      issuer_id: ENV["ASC_ISSUER_ID"],
      key_content: ENV["ASC_KEY_P8_BASE64"],
      is_key_content_base64: true,
      in_house: false
    )

    deliver(
      api_key: api_key,
      metadata_path: "./appstore/metadata",
      screenshots_path: "./appstore/screenshots",
      skip_binary_upload: true,
      skip_app_version_update: false,
      submit_for_review: false,
      automatic_release: false,
      overwrite_screenshots: true,
      run_precheck_before_submit: false,
      force: true
    )
  end
end
