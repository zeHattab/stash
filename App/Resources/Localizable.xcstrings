    "Скрыть пароль": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hide password"
          }
        }
      }
    },
    "Пароли не совпадают": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Passwords don't match"
          }
        }
      }
    },
    "Минимум %lld символов": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least %lld characters"
          }
        }
      }
    },
    "Создать сейф": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create vault"
          }
        }
      }
    },
    "Мастер-пароль нельзя восстановить. Запомните его — без него данные не открыть.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The master password can't be recovered. Remember it — without it the data can't be opened."
          }
        }
      }
    },
    "Новый сейф": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "New vault"
          }
        }
      }
