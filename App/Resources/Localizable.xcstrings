{
  "sourceLanguage": "ru",
  "version": "1.0",
  "strings": {
    "Stash": {
      "shouldTranslate": false
    },
    "https://example.com": {
      "shouldTranslate": false
    },
    "Добро пожаловать в Stash": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Welcome to Stash"
          }
        }
      }
    },
    "Менеджер паролей и документов, который работает полностью на вашем iPhone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A password and document manager that runs entirely on your iPhone."
          }
        }
      }
    },
    "Только на этом устройстве": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only on this device"
          }
        }
      }
    },
    "Данные хранятся только на этом iPhone и не уходят в интернет. Никакой аналитики и трекинга.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays only on this iPhone and never goes online. No analytics, no tracking."
          }
        }
      }
    },
    "Мастер-пароль нельзя восстановить": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The master password can't be recovered"
          }
        }
      }
    },
    "Если вы забудете мастер-пароль, данные пропадут безвозвратно. Мы не можем его сбросить.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you forget your master password, the data is lost for good. We cannot reset it."
          }
        }
      }
    },
    "Я понимаю": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand"
          }
        }
      }
    },
    "Подтвердите, что вы понимаете: пароль нельзя восстановить": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that you understand the password can't be recovered"
          }
        }
      }
    },
    "Далее": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next"
          }
        }
      }
    },
    "Создать мастер-пароль": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Create master password"
          }
        }
      }
    },
    "Мастер-пароль": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Master password"
          }
        }
      }
    },
    "Повторите пароль": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat password"
          }
        }
      }
    },
    "Показать пароль": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show password"
          }
        }
      }
