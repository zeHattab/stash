      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off second password"
          }
        }
      }
    },
    "Второй слот будет перезаписан случайными данными. Ложный сейф пропадёт.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The second slot will be overwritten with random data. The decoy vault will be gone."
          }
        }
      }
    },
    "Перейти в ложный сейф": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go to the decoy vault"
          }
        }
